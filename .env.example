# demo = fake deposit addresses + a "simulate payment" button (no real money)
# live = real deposits to YOUR wallets below, detected on-chain and credited automatically (withdrawals are paid by hand)
PAYMENT_MODE=demo

# Supabase -> Connect -> "Transaction pooler" connection string (replace [YOUR-PASSWORD] with the database password)
DATABASE_URL=

# Your wallets that receive deposits (live mode). Leave a coin empty to not offer it. You must control these addresses.
DEPOSIT_ADDR_BTC=
DEPOSIT_ADDR_LTC=
DEPOSIT_ADDR_USDTTRC20=
DEPOSIT_ADDR_USDTERC20=
DEPOSIT_ADDR_USDTBSC=

MIN_DEPOSIT_DOLLARS=1
MIN_WITHDRAW_DOLLARS=5

# Review page at /admin.html for paying withdrawals and crediting stray payments. 16+ random chars; admin is disabled if unset.
ADMIN_TOKEN=

# Secret for /api/cron/scan (16+ random chars). Used by the scheduled blockchain scan.
CRON_SECRET=

# Optional: https://your-domain (cookies are always marked Secure on Vercel)
PUBLIC_URL=
