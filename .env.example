# demo = fake addresses + "simulate payment" button (no real money)
# nowpayments = real crypto deposits via NOWPayments (https://nowpayments.io)
PAYMENT_PROVIDER=demo
PORT=3000

# Public URL of this site (needed for the payment webhook)
PUBLIC_URL=https://your-domain.com

# nowpayments only
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Minimum deposit in USD
MIN_DEPOSIT_USD=10

# Withdrawal review page at /admin.html. 16+ random chars; admin is disabled if unset.
ADMIN_TOKEN=
MIN_WITHDRAW_USD=10
