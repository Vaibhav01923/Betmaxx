# demo = fake deposit addresses + a "simulate payment" button (no real money)
# live = real deposits to YOUR wallets below, detected on-chain and credited automatically (withdrawals are paid by hand)
PAYMENT_MODE=demo
PORT=3000

# Public URL of this site (use https:// in production so cookies are marked Secure)
PUBLIC_URL=https://your-domain.com

# Your wallets that receive deposits (live mode). Leave a coin empty to not offer it. You must control these addresses.
DEPOSIT_ADDR_BTC=
DEPOSIT_ADDR_LTC=
DEPOSIT_ADDR_USDTTRC20=
DEPOSIT_ADDR_USDTERC20=
DEPOSIT_ADDR_USDTBSC=

MIN_DEPOSIT_USD=10
MIN_WITHDRAW_USD=10

# Review page at /admin.html for crediting deposits and paying withdrawals. 16+ random chars; admin is disabled if unset.
ADMIN_TOKEN=

# Supabase storage (accounts, balances, deposits, withdrawals, bets). Leave empty to use a local data.json for development.
# Run supabase/schema.sql in the Supabase SQL editor first. Use the SERVICE ROLE key; never expose it in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Behind a proxy such as Railway/Caddy: read the visitor IP from X-Forwarded-For
TRUST_PROXY=0
